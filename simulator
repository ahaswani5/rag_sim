let currentStep = -1;
let query = '';
let isRunning = false;

function setExample(el) {
  document.getElementById('queryInput').value = el.textContent;
  document.getElementById('queryInput').focus();
}

function buildSteps() {
  const wrapper = document.getElementById('stepsWrapper');
  wrapper.innerHTML = '';
  STEPS.forEach((step, idx) => {
    const card = document.createElement('div');
    card.className = 'step-card';
    card.id = `step_card_${step.id}`;
    card.style.setProperty('--step-color', step.color);
    card.style.setProperty('--step-color-dim', step.colorDim);
    card.innerHTML = `
      <div class="step-header" onclick="toggleBody(${step.id})">
        <div class="step-number">${step.id}</div>
        <div class="step-meta">
          <div class="step-tag">${step.tag}</div>
          <div class="step-title">${step.title}</div>
        </div>
        <div class="step-status">
          <span class="status-dot"></span>
          <span class="status-text" id="status_${step.id}">waiting</span>
        </div>
      </div>
      <div class="step-body" id="body_${step.id}">
        <div class="step-inner">
          <p class="step-desc">${step.desc}</p>
          <div id="viz_${step.id}"></div>
        </div>
      </div>
    `;
    wrapper.appendChild(card);
    if (idx < STEPS.length - 1) {
      const conn = document.createElement('div');
      conn.className = 'connector';
      conn.innerHTML = '↓';
      wrapper.appendChild(conn);
    }
  });
}

function toggleBody(stepId) {
  const body = document.getElementById(`body_${stepId}`);
  body.classList.toggle('open');
}

function setStepStatus(id, status) {
  const card = document.getElementById(`step_card_${id}`);
  const statusText = document.getElementById(`status_${id}`);
  card.className = `step-card ${status === 'active' ? 'active' : status === 'done' ? 'done' : ''}`;
  const step = STEPS.find(s => s.id === id);
  card.style.setProperty('--step-color', step.color);
  card.style.setProperty('--step-color-dim', step.colorDim);
  if (status === 'active') statusText.textContent = 'processing';
  if (status === 'done') statusText.textContent = 'done';
  if (status === 'waiting') statusText.textContent = 'waiting';
}

function openBody(id) {
  const body = document.getElementById(`body_${id}`);
  body.classList.add('open');
  body.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function closeBody(id) {
  const body = document.getElementById(`body_${id}`);
  body.classList.remove('open');
}

async function runStep(step) {
  setStepStatus(step.id, 'active');
  openBody(step.id);

  const viz = document.getElementById(`viz_${step.id}`);
  viz.innerHTML = `<div style="display:flex;align-items:center;gap:10px;padding:16px 0;color:var(--text-dim);font-family:var(--mono);font-size:12px"><span class="spinner"></span> Processing ${step.title.toLowerCase()}...</div>`;

  await delay(900 + Math.random() * 400);

  viz.innerHTML = step.renderViz(query);

  // Animate vector bars
  if (step.id === 2) {
    setTimeout(() => {
      document.querySelectorAll('.vector-bar-fill').forEach(bar => {
        const target = bar.style.width;
        bar.style.width = '0%';
        setTimeout(() => { bar.style.width = target; }, 100);
      });
    }, 100);
  }

  // Animate DB cells
  if (step.id === 3) {
    setTimeout(() => {
      [0,1,4,7].forEach((i,j) => {
        setTimeout(() => {
          const cell = document.getElementById(`dbcell_${i}`);
          if (cell) cell.classList.add('matched');
        }, j * 150);
      });
    }, 300);
  }

  await delay(400);
  setStepStatus(step.id, 'done');
  const progress = (step.id / STEPS.length) * 100;
  document.getElementById('progressFill').style.width = progress + '%';
}

function delay(ms) {
  return new Promise(resolve => setTimeout(resolve, ms));
}

async function runRAG() {
  if (isRunning) return;
  query = document.getElementById('queryInput').value.trim();
  if (!query) {
    document.getElementById('queryInput').style.borderColor = 'rgba(249,115,22,0.5)';
    setTimeout(() => document.getElementById('queryInput').style.borderColor = '', 1500);
    return;
  }

  isRunning = true;
  document.getElementById('runBtn').disabled = true;
  document.getElementById('runBtn').innerHTML = '<span class="spinner"></span> Running...';
  document.getElementById('queryInput').disabled = true;
  document.getElementById('progressFill').style.width = '0%';

  buildSteps();
  await delay(200);

  for (const step of STEPS) {
    await runStep(step);
    await delay(350);
  }

  document.getElementById('finalMessage').classList.add('visible');
  document.getElementById('resetBtn').classList.add('visible');
  isRunning = false;
}

function resetAll() {
  document.getElementById('queryInput').value = '';
  document.getElementById('queryInput').disabled = false;
  document.getElementById('runBtn').disabled = false;
  document.getElementById('runBtn').innerHTML = 'Run Pipeline →';
  document.getElementById('progressFill').style.width = '0%';
  document.getElementById('finalMessage').classList.remove('visible');
  document.getElementById('resetBtn').classList.remove('visible');
  document.getElementById('stepsWrapper').innerHTML = '';
  isRunning = false;
  query = '';
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

// Enter key support
document.addEventListener('DOMContentLoaded', () => {
  document.getElementById('queryInput').addEventListener('keydown', (e) => {
    if (e.key === 'Enter') runRAG();
  });
});
</script>
